# Copy to .env and generate a Base64 secret from at least 32 random bytes.
JWT_SECRET=
# Only the h2 profile creates this optional local test account.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
# Only the h2 profile creates this optional local admin account (at least 12 characters).
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
# MySQL (Docker Compose, mysql profile)
MYSQL_DATABASE=mydatabase
MYSQL_USER=myuser
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
